PhoneNumber=
Password=

# Optional settings
# CHAOXING_HEADLESS=false
# CHAOXING_BROWSER_CHANNEL=chrome
# CHAOXING_BROWSER_PATH=
# CHAOXING_NO_SANDBOX=false   # root/无沙箱环境（Docker、云服务器）设为 true
# CHAOXING_TIMEOUT_MS=30000
# CHAOXING_STORAGE_STATE=.auth/chaoxing-storage-state.json
# CHAOXING_COURSES_PATH=artifacts/incomplete-courses.json
# CHAOXING_TARGET_COURSE=科研诚信
# CHAOXING_TARGET_LESSON=2.1 科学海洋上的高远星空
# CHAOXING_VIDEO_PREVIEW_SECONDS=30
# CHAOXING_PROGRESS_CONCURRENCY=2
# CHAOXING_PROGRESS_PATH=artifacts/course-progress.json
# CHAOXING_PROGRESS_MARKDOWN_PATH=artifacts/course-progress.md

# 自动学习（study）模式：DeepSeek 官方接口
# CHAOXING_DEEPSEEK_API_KEY=sk-...
# CHAOXING_LLM_MODEL=deepseek-chat
# CHAOXING_LLM_BASE_URL=https://api.deepseek.com
# CHAOXING_STUDY_REPORT_PATH=artifacts/study-report.json
# CHAOXING_STUDY_REPORT_MARKDOWN_PATH=artifacts/study-report.md
# 学习备忘录（每课节记录视频/作业两个完成状态，运行中持续原子写入）
# CHAOXING_STUDY_MEMO_PATH=artifacts/study-memo.json
# CHAOXING_STUDY_MEMO_MARKDOWN_PATH=artifacts/study-memo.md
# CHAOXING_VIDEO_TARGET_PERCENT=95
# CHAOXING_VIDEO_SPEED=2      # 视频倍速，0.5~4，默认 2（二倍速）
# CHAOXING_VIDEO_RETRY_LIMIT=3
# 只学习指定课程（逗号分隔关键字）；留空 = 全部未完成课程
# CHAOXING_STUDY_COURSES=创新创业
